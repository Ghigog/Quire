<?xml version="1.0" encoding="utf-8"?>
<!--
  QUI-025 / CLAUDE.md §7: no animated progress, no shimmer loaders. The book list is a
  single ScrollView + LinearLayout rebuilt wholesale on every refresh (one frame, not a
  sequence of partial-refresh mutations that would ghost on e-ink) rather than a
  RecyclerView with item animations to suppress.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper_white"
    android:padding="24dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/ink_black"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/import_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/import_button" />

    <Button
        android:id="@+id/cloud_voice_settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cloud_voice_button" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/book_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
