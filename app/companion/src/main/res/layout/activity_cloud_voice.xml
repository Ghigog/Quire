<?xml version="1.0" encoding="utf-8"?>
<!--
  QUI-042 / CLAUDE.md §7: same e-ink rules as activity_main.xml — pure black on white, no
  animation, plain platform widgets rather than Material.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_voice_title"
            android:textColor="@color/ink_black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cloud_voice_explainer"
            android:textColor="@color/ink_black" />

        <TextView
            android:id="@+id/cloud_voice_estimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink_black"
            android:textStyle="bold"
            android:visibility="gone" />

        <Switch
            android:id="@+id/cloud_voice_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cloud_voice_enable" />

        <EditText
            android:id="@+id/cloud_voice_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints="url"
            android:hint="@string/cloud_voice_endpoint_hint"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/cloud_voice_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:hint="@string/cloud_voice_key_hint"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/cloud_voice_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cloud_voice_id_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/cloud_voice_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cloud_voice_price_hint"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/cloud_voice_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cloud_voice_save" />
    </LinearLayout>
</ScrollView>
