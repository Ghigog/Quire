{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quire.local/schema/characters.schema.json",
  "title": "Quire character manifest",
  "description": "The cast of one book, produced by the upfront scan (QUI-007) and consumed by attribution, casting and the character drawer. Unknown properties are preserved by readers rather than rejected, so a newer companion app can round-trip a manifest through an older TTS service without losing data.",
  "type": "object",
  "required": ["schemaVersion", "bookId", "generatedAt", "narrator", "characters"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "bookId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "integer", "description": "Unix epoch milliseconds." },
    "narrator": { "$ref": "#/definitions/character" },
    "characters": { "type": "array", "items": { "$ref": "#/definitions/character" } }
  },
  "definitions": {
    "character": {
      "type": "object",
      "required": ["id", "displayName"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Stable within a book. Duplicates are rejected: casting keys on it." },
        "displayName": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "gender": { "enum": ["male", "female", "neutral", "unknown"], "description": "An unrecognised value degrades to unknown rather than failing the load." },
        "ageBand": { "enum": ["child", "teen", "adult", "elder", "unknown"] },
        "traits": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "firstSeenLocator": { "type": "string", "description": "Where they first speak, as chapter#p3#s1." },
        "lineCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
